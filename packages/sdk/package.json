{
  "name": "@agenttrace/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for AgentTrace tamper-evident audit trails",
  "author": "AgentTrace",
  "license": "MIT",
  "homepage": "https://github.com/zsl2006819/agenttrace",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsl2006819/agenttrace.git"
  },
  "bugs": {
    "url": "https://github.com/zsl2006819/agenttrace/issues"
  },
  "keywords": [
    "agenttrace",
    "ai-agents",
    "audit",
    "tamper-evident",
    "compliance",
    "eu-ai-act",
    "soc-2",
    "iso-42001"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.0",
    "canonicalize": "^1.0.8"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}